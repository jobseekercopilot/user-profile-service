{
  "openapi": "3.0.3",
  "info": {
    "title": "Job Seeker Copilot User Profile API",
    "version": "1.1.0",
    "description": "Producer-owned contract for authenticated current-user profile and versioned evidence operations."
  },
  "tags": [
    {
      "name": "User Profiles",
      "description": "Authenticated current-user profile operations"
    },
    {
      "name": "Evidence Library",
      "description": "Authenticated owner-scoped reusable evidence operations"
    }
  ],
  "paths": {
    "/api/profiles/me": {
      "get": {
        "tags": [
          "User Profiles"
        ],
        "operationId": "getMyProfile",
        "summary": "Get the authenticated user's profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile found",
            "headers": {
              "ETag": {
                "description": "Quoted monotonic profile revision for optimistic concurrency",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "404": {
            "description": "Profile not found"
          }
        }
      },
      "put": {
        "tags": [
          "User Profiles"
        ],
        "operationId": "createOrUpdateMyProfile",
        "summary": "Create or replace the authenticated user's profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "description": "Optional quoted profile revision. Omission is retained temporarily for legacy clients.",
            "schema": {
              "type": "string",
              "pattern": "^\"?[0-9]+\"?$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile saved",
            "headers": {
              "ETag": {
                "description": "Quoted resulting profile revision",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "400": {
            "description": "Profile validation failed"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "409": {
            "description": "Stale profile revision or concurrent profile write conflict"
          }
        }
      }
    },
    "/api/evidence": {
      "get": {
        "tags": [
          "Evidence Library"
        ],
        "operationId": "listEvidence",
        "summary": "List evidence owned by the authenticated claimant",
        "description": "Includes review-required drafts created idempotently from legacy roles and qualifications.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped evidence entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EvidenceEntry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      }
    },
    "/api/evidence/{entryId}": {
      "get": {
        "tags": [
          "Evidence Library"
        ],
        "operationId": "getEvidence",
        "summary": "Get one evidence entry owned by the authenticated claimant",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "entryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceEntry"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "404": {
            "description": "Entry does not exist or is owned by another claimant"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "userId": {
            "type": "string",
            "maxLength": 128,
            "readOnly": true
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "readOnly": true,
            "description": "Monotonic revision of claimant-declared profile content"
          },
          "revisionId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "description": "Immutable opaque identity for this profile revision"
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "readOnly": true,
            "description": "SHA-256 digest of normalized claimant-declared profile content"
          },
          "skills": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "aspirations": {
            "$ref": "#/components/schemas/Aspirations"
          },
          "workPreferences": {
            "$ref": "#/components/schemas/WorkPreferences"
          },
          "qualifications": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Qualification"
            }
          },
          "roles": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          }
        }
      },
      "Aspirations": {
        "type": "object",
        "properties": {
          "targetRoles": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "targetWeeklyHours": {
            "$ref": "#/components/schemas/TargetWeeklyHours"
          }
        }
      },
      "TargetWeeklyHours": {
        "type": "string",
        "enum": [
          "FULL_TIME",
          "PART_TIME_16_30",
          "PART_TIME_UNDER_16",
          "FLEXIBLE"
        ]
      },
      "WorkPreferences": {
        "type": "object",
        "properties": {
          "location": {
            "$ref": "#/components/schemas/PostcodeLocation"
          },
          "commuteRange": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          }
        }
      },
      "PostcodeLocation": {
        "type": "object",
        "properties": {
          "postcode": {
            "type": "string",
            "maxLength": 16,
            "description": "UK full postcode or outcode; normalized by the service"
          },
          "region": {
            "type": "string",
            "maxLength": 100
          },
          "adminDistrict": {
            "type": "string",
            "maxLength": 100
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Qualification": {
        "type": "object",
        "required": [
          "qualificationName",
          "issuingBody",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "qualificationName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "issuingBody": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "$ref": "#/components/schemas/QualificationStatus"
          },
          "grade": {
            "type": "string",
            "maxLength": 100
          },
          "dateAchieved": {
            "type": "string",
            "maxLength": 30,
            "description": "YYYY-MM or YYYY-MM-DD"
          },
          "expectedCompletion": {
            "type": "string",
            "maxLength": 30,
            "description": "YYYY-MM or YYYY-MM-DD"
          }
        }
      },
      "QualificationStatus": {
        "type": "string",
        "enum": [
          "IN_PROGRESS",
          "COMPLETED"
        ]
      },
      "Role": {
        "type": "object",
        "required": [
          "jobTitle",
          "employer",
          "status",
          "startDate"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "jobTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "employer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "$ref": "#/components/schemas/RoleStatus"
          },
          "startDate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "YYYY-MM or YYYY-MM-DD"
          },
          "endDate": {
            "type": "string",
            "maxLength": 30,
            "description": "YYYY-MM or YYYY-MM-DD"
          },
          "keyResponsibilities": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "RoleStatus": {
        "type": "string",
        "enum": [
          "CURRENT",
          "PREVIOUS_ROLE"
        ]
      },
      "EvidenceEntry": {
        "type": "object",
        "required": [
          "entryId",
          "category",
          "visibility",
          "lifecycle",
          "reviewRequired",
          "revisions"
        ],
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "category": {
            "$ref": "#/components/schemas/EvidenceCategory"
          },
          "visibility": {
            "$ref": "#/components/schemas/EvidenceVisibility"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/EvidenceLifecycle"
          },
          "supersededByEntryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "reviewRequired": {
            "type": "boolean",
            "description": "True when a claimant must review imported or changed evidence before confirmation"
          },
          "revisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceRevision"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "EvidenceRevision": {
        "type": "object",
        "required": [
          "revisionId",
          "revisionNumber",
          "confirmationState",
          "contentDigest",
          "heading",
          "ongoing",
          "demonstratedSkills",
          "supportingLinks",
          "facts",
          "createdAt",
          "createdBy"
        ],
        "properties": {
          "revisionId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "revisionNumber": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true
          },
          "confirmationState": {
            "$ref": "#/components/schemas/EvidenceConfirmationState"
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "readOnly": true
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "organisationContext": {
            "type": "string",
            "maxLength": 200
          },
          "roleTitle": {
            "type": "string",
            "maxLength": 200
          },
          "programmeOrSubject": {
            "type": "string",
            "maxLength": 200
          },
          "institution": {
            "type": "string",
            "maxLength": 200
          },
          "qualificationTitle": {
            "type": "string",
            "maxLength": 200
          },
          "issuer": {
            "type": "string",
            "maxLength": 200
          },
          "resultOrStatus": {
            "type": "string",
            "maxLength": 100
          },
          "projectRole": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "responsibilities": {
            "type": "string",
            "maxLength": 4000
          },
          "achievements": {
            "type": "string",
            "maxLength": 4000
          },
          "careerBreakReason": {
            "type": "string",
            "maxLength": 1000,
            "description": "Optional and never eligible for automatic selection"
          },
          "privateCredentialIdentifier": {
            "type": "string",
            "maxLength": 500,
            "description": "Claimant-visible private value; excluded from model input by default"
          },
          "ongoing": {
            "type": "boolean"
          },
          "startDate": {
            "$ref": "#/components/schemas/PartialDate"
          },
          "endDate": {
            "$ref": "#/components/schemas/PartialDate"
          },
          "issueDate": {
            "$ref": "#/components/schemas/PartialDate"
          },
          "expiryDate": {
            "$ref": "#/components/schemas/PartialDate"
          },
          "demonstratedSkills": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "supportingLinks": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://"
            }
          },
          "facts": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/EvidenceFact"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "createdBy": {
            "type": "string",
            "readOnly": true,
            "enum": [
              "USER",
              "LEGACY_MIGRATION",
              "SYSTEM"
            ]
          }
        }
      },
      "PartialDate": {
        "type": "object",
        "required": [
          "precision",
          "year"
        ],
        "properties": {
          "precision": {
            "type": "string",
            "enum": [
              "YEAR",
              "MONTH",
              "DAY"
            ]
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          }
        }
      },
      "EvidenceFact": {
        "type": "object",
        "required": [
          "factId",
          "factType",
          "factValue",
          "numericClaim",
          "position"
        ],
        "properties": {
          "factId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "factType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "factValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "numericClaim": {
            "type": "boolean"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "EvidenceCategory": {
        "type": "string",
        "enum": [
          "EMPLOYMENT",
          "EDUCATION",
          "QUALIFICATION_TRAINING",
          "PROJECT",
          "VOLUNTEERING",
          "FREELANCE",
          "ACHIEVEMENT",
          "CAREER_BREAK",
          "OTHER"
        ]
      },
      "EvidenceConfirmationState": {
        "type": "string",
        "enum": [
          "DRAFT",
          "USER_CONFIRMED"
        ]
      },
      "EvidenceVisibility": {
        "type": "string",
        "enum": [
          "VISIBLE",
          "HIDDEN"
        ]
      },
      "EvidenceLifecycle": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "ARCHIVED",
          "SUPERSEDED"
        ]
      }
    }
  }
}
